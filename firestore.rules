rules_version = '2';

// Everything in this database (query logs, rate-limit counters) is read and
// written only by the Cloud Run backend through the Admin SDK, which bypasses
// these rules. No browser should ever touch Firestore directly: the logs hold
// students' immigration questions. Deny all client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
